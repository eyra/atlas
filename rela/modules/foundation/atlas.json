{
  "todo": {
    "title": "What to do",
    "why": "Why",
    "instructions": "How",
    "answers": "Answers"
  },
  "runtime": {
    "turn": {
      "kind": "turn",
      "key": "TU-{on}-{n}",
      "on": "turn_on",
      "by": "turn_by",
      "state": "state",
      "running": "running",
      "ended": "ended",
      "machine": "machine",
      "lease": "lease_until",
      "activity": "activity",
      "why": "why",
      "ended_at": "ended_at",
      "outcome": "outcome",
      "attempt": "attempt"
    },
    "agent": {
      "cannot_run": "cannot_run"
    }
  },
  "start": {
    "assigned": {
      "relation": "assigned_to",
      "title": "Assigned to you",
      "count": "{count} assigned to you"
    },
    "open": {
      "title": "Open work",
      "empty": "Nothing is open: no fact is assigned to anyone, and nothing is expected."
    }
  },
  "relations": {
    "assigned_to": {
      "actions": {
        "change": {
          "label": "Hand to\u2026",
          "key": "h",
          "with": [
            "deadline"
          ],
          "cause": "handed to {to} by {by}"
        }
      }
    }
  },
  "entities": {
    "person": {
      "top": false,
      "primary": "name",
      "create": {
        "ask": [
          "name"
        ],
        "id": {
          "from": "name",
          "pattern": "^\\s*([A-Za-z][A-Za-z0-9]*)",
          "template": "{1}",
          "lower": true,
          "error": "name must start with a letter, e.g. Melle"
        }
      }
    },
    "assignment": {
      "top": false,
      "by_hand": "update",
      "late": {
        "after": "deadline",
        "while": "expected",
        "label": "late"
      },
      "primary": "of",
      "create": {
        "ask": [
          "of"
        ],
        "id": {
          "from": "of",
          "pattern": "^(.+)$",
          "template": "AS-{1}",
          "error": "of must be the key of the fact it belongs to"
        }
      },
      "properties": {
        "expected": {
          "set_by": [
            "flow",
            "migration"
          ]
        },
        "handover": {
          "set_by": [
            "flow"
          ]
        }
      }
    },
    "turn": {
      "top": false,
      "by_hand": false,
      "order": "newest",
      "properties": {
        "state": {
          "set_by": [
            "runtime"
          ]
        },
        "machine": {
          "set_by": [
            "runtime"
          ]
        },
        "lease_until": {
          "set_by": [
            "runtime"
          ],
          "label": "Lease until"
        },
        "activity": {
          "set_by": [
            "runtime"
          ]
        },
        "why": {
          "set_by": [
            "runtime"
          ]
        },
        "ended_at": {
          "set_by": [
            "runtime"
          ],
          "label": "Ended at"
        },
        "outcome": {
          "set_by": [
            "turn_owner"
          ],
          "multiline": true
        },
        "attempt": {
          "set_by": [
            "runtime"
          ]
        }
      }
    },
    "agent": {
      "properties": {
        "cannot_run": {
          "set_by": [
            "runtime"
          ],
          "label": "Cannot run"
        }
      },
      "top": false,
      "counts": [
        {
          "relation": "assigned_to",
          "text": "{count} assigned"
        }
      ],
      "primary": "name",
      "create": {
        "ask": [
          "name"
        ],
        "id": {
          "from": "name",
          "pattern": "^\\s*([A-Za-z][A-Za-z0-9]*)",
          "template": "{1}",
          "lower": true,
          "error": "name must start with a letter, e.g. Coordinator"
        }
      }
    },
    "worker_execution": {
      "top": false,
      "by_hand": false
    },
    "interaction": {
      "top": false,
      "by_hand": false
    },
    "interaction_receipt": {
      "top": false,
      "by_hand": false
    }
  },
  "guidance": {
    "execution": {
      "kind": "worker_execution",
      "fields": {
        "environment": "environment",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "machine": "machine",
        "harness": "harness",
        "harness_version": "harness_version",
        "configured_model": "configured_model",
        "reported_model": "reported_model",
        "capability_version": "capability_version",
        "queued_input": "queued_input",
        "durable_accept_query": "durable_accept_query",
        "consumption_evidence": "consumption_evidence",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    },
    "interaction": {
      "kind": "interaction",
      "fields": {
        "environment": "environment",
        "actor": "actor",
        "client_key": "client_key",
        "body": "body",
        "body_digest": "body_digest",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "mode": "mode",
        "execution": "execution",
        "cause": "cause",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    },
    "receipt": {
      "kind": "interaction_receipt",
      "fields": {
        "environment": "environment",
        "interaction": "interaction",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "execution": "execution",
        "stage": "stage",
        "evidence_id": "evidence_id",
        "admission_id": "admission_id",
        "consumption_id": "consumption_id",
        "reason": "reason",
        "writer": "writer",
        "cause": "cause",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    }
  }
}
