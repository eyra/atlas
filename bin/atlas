#!/usr/bin/env bash
# atlas: try Atlas from any folder.
#
#   atlas              open a TUI on prod; starts rela and the core in the background when
#                      they are not answering, and restarts a core from an older build
#   atlas tui          the same; open as many as you like, each in its own terminal
#   atlas stop         stop the core (rela keeps running)
#   atlas restart      stop the core and start this build in the background
#   atlas status       what runs, and which build
#   atlas logs         follow the core's log
#   atlas where        the folder the build comes from
#   atlas main-clone   the main clone, which `atlas tui` updates to the newest develop
#   atlas env          the environment a command works on, and its settings file
#   atlas install      link `atlas` into ~/.local/bin (from the main clone only)
#   atlas up           run the core in the foreground (what `atlas` starts in the background)
#   atlas e2e [uc-atlas-01 ...]  the end-to-end test, on a private test instance of its own
#   atlas rela-status, atlas rela-stop
#
#   atlas help [<kind>] [--json]    the agents' commands, and every kind from rela's description:
#                      what a create asks, its id, its parent, its fields (Control must run)
#   atlas put <kind> [--in <key>] --title <text> --description-file <path>   create
#   atlas set <key> <field>=<text> ...       change, e.g. `atlas set IS-Atlas-12 stage=testing`
#   atlas get <key> [--json]                 one item, and what hangs under it
#   atlas list <kind> [--json]               the items of a kind
#   atlas delete <key> [--json]              delete; refused while anything hangs under it
#   atlas tools [--json]                     the agent's tools: Control's actions, from the description
#   atlas plan --on <key> <request>          what the agent proposes for a request on that page;
#                      it reads through Control and writes nothing (UC-Atlas-16)
#   atlas steer                              the agent behind the TUI's `:`, in JSON lines on
#                      stdin and stdout; the TUI starts it (UC-Atlas-17)
#   atlas load-plan <SCENES.md> <links.json> [--dry-run]   UC-Atlas-05: the plan into Atlas
#                      put, set, get, list, tools, plan and load-plan go through Control like the TUI,
#                      and start nothing: Control must run (`atlas status`).
#
# Every command works on prod unless it gets --env test: `atlas tui --env test`. Scripts,
# tests and agents always pass --env test, or ATLAS_ENV_FILE: a private instance (other
# ports and data) whose environment is the file's "env", so a trial never meets Melle's.
# --env and the file's "env" must agree. ATLAS_NO_UPDATE=1 keeps `atlas tui` from
# updating the main clone first.
set -euo pipefail

# The repository this script lives in, also when it is called through a link.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd -P)"
usage() { sed -n '2,39p' "$root/bin/atlas" | sed 's/^# \{0,1\}//'; exit 2; }

caller="$PWD"
no_env() { echo "atlas: --env needs test or prod" >&2; exit 2; }

cmd=tui
case "${1:-}" in -*|"") ;; *) cmd="$1"; shift ;; esac
env=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --env) [ -n "${2:-}" ] || no_env; env="$2"; shift 2 ;;
    --env=?*) env="${1#--env=}"; shift ;;
    --env=) no_env ;;
    *)
      case "$cmd" in
        e2e|put|set|get|list|delete|tools|plan|steer|load-plan|help) args+=("$1"); shift ;;
        *) case "$1" in -h|--help) usage ;; *) echo "atlas: unknown option $1" >&2; usage ;; esac ;;
      esac ;;
  esac
done

# The end-to-end test makes its own private test instance; it never reads env/<env>.json
# and never runs on prod.
if [ "$cmd" = e2e ]; then
  if [ -n "$env" ] && [ "$env" != test ]; then
    echo "atlas: e2e runs only on a private test instance, never on $env" >&2; exit 1
  fi
  cd "$root/e2e" && exec mix atlas.e2e ${args[@]+"${args[@]}"}
fi

settings="${ATLAS_ENV_FILE:-}"
if [ -z "$settings" ]; then
  env="${env:-prod}"
  settings="$root/env/$env.json"
fi
[ -f "$settings" ] || { echo "atlas: no environment '$env' (no $settings)" >&2; exit 1; }
# Absolute, so the core and the clients find it from their own folders.
settings="$(cd "$(dirname "$settings")" && pwd -P)/$(basename "$settings")"
[ -z "${ATLAS_ENV_FILE:-}" ] || export ATLAS_ENV_FILE="$settings"

# A value from the settings file: plutil on macOS, jq elsewhere (CI).
setting() {
  local v
  if command -v plutil >/dev/null; then v="$(plutil -extract "$1" raw -o - "$settings")"; else v="$(jq -er ".$1" "$settings")"; fi
  echo "${v/#\~/$HOME}"
}
# The file says which environment it is; a private file without --env is that one.
file_env="$(setting env)"
env="${env:-$file_env}"
case "$env" in test|prod) ;; *) echo "atlas: no environment '$env'; use --env test or --env prod" >&2; exit 1 ;; esac
if [ "$file_env" != "$env" ]; then
  echo "atlas: $settings is for $file_env, not $env" >&2; exit 1
fi
export ATLAS_ROOT="$root" ATLAS_ENV="$env"

rela_url="$(setting rela.url)"
port="$(setting control.port)"
# The rela scripts take their port, data and binaries from these.
export ATLAS_RELA_PORT="$(setting rela.port)" ATLAS_RELA_DATA="$(setting rela.data)" ATLAS_RELA_BIN="$(setting rela.bin)"
export ATLAS_TEST_ROOT="$(dirname "$ATLAS_RELA_DATA")"

# The background core's files, beside rela's (the same files the stopgap used).
state="$ATLAS_TEST_ROOT"
pidfile="$state/core.pid"
headfile="$state/core.head"
log="$state/core.log"

head_now() { git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown; }
listening() { nc -z 127.0.0.1 "$port" 2>/dev/null; }

core_pid() {
  local pid; pid="$(cat "$pidfile" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

stop_core() {
  local pid; pid="$(core_pid || true)"
  if [ -n "$pid" ]; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  # A core started by hand (atlas up) on this environment's port is stopped too.
  local other; other="$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -n "$other" ]; then
    kill -TERM $other 2>/dev/null || true
    for _ in $(seq 1 20); do listening || break; sleep 0.5; done
  fi
  rm -f "$pidfile" "$headfile"
}

start_core() {
  echo "atlas: starting the core from $root at $(head_now) (a first start compiles, about half a minute)..."
  mkdir -p "$state"
  nohup "$root/bin/atlas" up --env "$env" >"$log" 2>&1 </dev/null &
  echo $! >"$pidfile"
  head_now >"$headfile"
  for _ in $(seq 1 240); do
    listening && { echo "atlas: core ready"; return 0; }
    kill -0 "$(cat "$pidfile")" 2>/dev/null || { echo "atlas: the core stopped; the last lines of $log:" >&2; tail -20 "$log" >&2; exit 1; }
    sleep 0.5
  done
  echo "atlas: the core did not start within 2 minutes; see $log" >&2
  exit 1
}

# A core from another build than this checkout is restarted, so nobody tries an old build.
ensure_core() {
  if listening && [ "$(cat "$headfile" 2>/dev/null)" != "$(head_now)" ]; then
    echo "atlas: the running core is not this build ($(head_now)); restarting it"
    stop_core
  fi
  listening || { [ -z "$(core_pid || true)" ] || stop_core; start_core; }
}

# The main clone follows develop: take the newest build before trying it.
update_build() {
  [ -z "${ATLAS_NO_UPDATE:-}" ] || return 0
  if [ "$(main_clone)" = "$root" ] && [ "$(git -C "$root" branch --show-current)" = develop ]; then
    git -C "$root" pull --ff-only -q || echo "atlas: could not update develop; trying the build as it is" >&2
  fi
}

# The repository's main clone (not a worktree of it). git answers an absolute path, so
# this works from any folder, also from / or from inside another repository.
main_clone() {
  local common
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  (cd "$common/.." && pwd -P)
}

case "$cmd" in
  tui)
    update_build
    curl -fsS -o /dev/null "$rela_url/_schema" 2>/dev/null || "$root/rela/scripts/start-bg.sh"
    ensure_core
    # Ctrl-S saves a form; without this the terminal would take it as "pause output".
    saved="$(stty -g 2>/dev/null || true)"
    stty -ixon 2>/dev/null || true
    cd "$root/clients/tui"
    status=0
    mix atlas.tui --env "$env" || status=$?
    [ -n "$saved" ] && stty "$saved" 2>/dev/null || true
    exit $status
    ;;
  up)
    if curl -fsS -o /dev/null "$rela_url/_schema" 2>/dev/null; then
      echo "rela $env: answering at $rela_url"
    else
      "$root/rela/scripts/start-bg.sh"
    fi
    cd "$root/beam"
    exec mix run --no-halt
    ;;
  stop) stop_core; echo "atlas: core stopped (rela keeps running)" ;;
  restart)
    stop_core
    curl -fsS -o /dev/null "$rela_url/_schema" 2>/dev/null || "$root/rela/scripts/start-bg.sh"
    start_core
    ;;
  status)
    echo "env:    $env ($settings)"
    echo "build:  $root at $(head_now)"
    if pid="$(core_pid)"; then
      echo "core:   running (pid $pid, build $(cat "$headfile" 2>/dev/null)), log $log"
    elif listening; then
      echo "core:   a core listens on $port, started by hand (atlas up)"
    else
      echo "core:   not running"
    fi
    "$root/rela/scripts/status.sh" 2>&1 | sed 's/^/rela:   /' || true
    ;;
  logs) exec tail -f "$log" ;;
  where) echo "$root" ;;
  main-clone) main_clone ;;
  env) echo "$env $settings" ;;
  install)
    # Only the main clone: a worktree goes away, and its build is not develop.
    if [ "$(main_clone)" != "$root" ]; then
      echo "atlas: install from the main clone ($(main_clone)), not from a worktree" >&2
      exit 1
    fi
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$root/bin/atlas" "$HOME/.local/bin/atlas"
    echo "atlas: ~/.local/bin/atlas -> $root/bin/atlas"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "atlas: add ~/.local/bin to your PATH" ;; esac
    ;;
  # The clients run in their own folders; a path the caller gives is read from where they called.
  put|set|get|list|delete|tools|plan|steer|help)
    # `atlas help` (not --json) starts with this script's own commands; `atlas help <kind>`
    # shows that kind only.
    kind_named=""
    for arg in ${args[@]+"${args[@]}"}; do case "$arg" in -*) ;; *) kind_named=1 ;; esac; done
    if [ "$cmd" = help ] && [ -z "$kind_named" ] && [[ " ${args[*]-} " != *" --json "* ]]; then
      sed -n '2,39p' "$root/bin/atlas" | sed 's/^# \{0,1\}//'; echo
    fi
    cd "$root/clients/agent"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.agent "$cmd" --env "$env" ${args[@]+"${args[@]}"}
    ;;
  load-plan)
    cd "$root/tools/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.load_plan --env "$env" ${args[@]+"${args[@]}"}
    ;;
  rela-status) exec "$root/rela/scripts/status.sh" ;;
  rela-stop) exec "$root/rela/scripts/stop.sh" ;;
  *) usage ;;
esac
