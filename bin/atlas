#!/usr/bin/env bash
# atlas: try Atlas from any folder.
#
#   atlas              open a TUI on prod; starts rela and the core in the background when
#                      they are not answering, and restarts a core from an older build
#   atlas tui          the same; open as many as you like, each in its own terminal
#   atlas stop         stop the core (rela keeps running)
#   atlas restart      stop the core and start this build in the background; rela too, when
#                      it runs an older description than this build (its data stays)
#   atlas status       what runs, which build, and whether rela runs this build's description
#   atlas logs         follow the core's log
#   atlas where        the folder the build comes from
#   atlas main-clone   the main clone, which `atlas tui` updates to the newest develop
#   atlas env          the environment a command works on, and its settings file
#   atlas install      link `atlas` into ~/.local/bin (from the main clone only)
#   atlas up           run the core in the foreground (what `atlas` starts in the background)
#   atlas e2e [uc-atlas-01 ...]  the end-to-end test, on a private test instance of its own
#   atlas rela-status, atlas rela-stop
#
#   atlas help [<kind>] [--json]    the agents' commands, and every kind from rela's description:
#                      what a create asks, its id, its parent, its fields (Control must run)
#   atlas put <kind> [--in <key>] --title <text> --description-file <path>   create
#   atlas set <key> <field>=<text> ...       change, e.g. `atlas set IS-Atlas-12 stage=design`
#   atlas get <key> [--json]                 one item, and what hangs under it
#   atlas list <kind> [--json]               the items of a kind
#   atlas delete <key> [--json]              delete; refused while anything hangs under it
#   atlas tools [--json]                     the agent's tools: Control's actions, from the description
#   atlas plan --on <key> <request>          what the agent proposes for a request on that page;
#                      it reads through Control and writes nothing (UC-Atlas-16)
#   atlas steer                              the agent behind the TUI's `:`, in JSON lines on
#                      stdin and stdout; the TUI starts it (UC-Atlas-17)
#   atlas load-plan <SCENES.md> <links.json> [--dry-run]   UC-Atlas-05: the plan into Atlas
#   atlas migrate-completion [--dry-run]     UC-Atlas-32: completion becomes an association;
#                      after a real run it stops rela, removes the old completed values, starts it
#   atlas migrate-owner [--dry-run]          IS-Atlas-52: every fact gets an owner, the coordinator
#                      agent, one fact each with cause "owner introduced"; --dry-run first
#   atlas migrate-assignment [--dry-run]     IS-Atlas-78: every fact gets its Assignment, and its owner
#                      moves there; run it on the old core and rela: it keeps who set each owner,
#                      restarts rela and the core on this build, writes, and removes the old values
#                      put, set, get, list, delete, tools, plan, load-plan and the migrations go
#                      through Control like the TUI, and start nothing: Control must run (`atlas status`).
#
# On Fly (IS-Atlas-26): an environment whose settings have a "fly" section (test) runs its
# core and rela on Fly, on its own private network; a merge to develop deploys them (CI).
# The commands above reach its Control through a WireGuard tunnel (`fly proxy`) that they
# open in the background; `atlas status` and `atlas logs` show Fly's machines and logs.
#   atlas move-to-fly [--from <folder>] [--dry-run]   copy this Mac's test data (rela/ and
#                      beam/ in <folder>, by default the one the Mac kept test's data in) to
#                      the Fly apps, replacing theirs (kept there in /data/before-move)
#
# Every command works on prod unless it gets --env test: `atlas tui --env test`. Scripts,
# tests and agents always pass --env test, or ATLAS_ENV_FILE: a private instance (other
# ports and data) whose environment is the file's "env", so a trial never meets Melle's.
# --env and the file's "env" must agree. ATLAS_NO_UPDATE=1 keeps `atlas tui` from
# updating the main clone first.
set -euo pipefail

# The repository this script lives in, also when it is called through a link.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd -P)"
# The comment above, up to `set -euo pipefail`: the usage.
header() { sed -n '2,/^set -euo/p' "$root/bin/atlas" | sed '$d' | sed 's/^# \{0,1\}//'; }
usage() { header; exit 2; }

caller="$PWD"
no_env() { echo "atlas: --env needs test or prod" >&2; exit 2; }

cmd=tui
case "${1:-}" in -*|"") ;; *) cmd="$1"; shift ;; esac
env=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --env) [ -n "${2:-}" ] || no_env; env="$2"; shift 2 ;;
    --env=?*) env="${1#--env=}"; shift ;;
    --env=) no_env ;;
    *)
      case "$cmd" in
        e2e|put|set|get|list|delete|tools|plan|steer|load-plan|migrate-completion|migrate-owner|migrate-assignment|move-to-fly|help) args+=("$1"); shift ;;
        *) case "$1" in -h|--help) usage ;; *) echo "atlas: unknown option $1" >&2; usage ;; esac ;;
      esac ;;
  esac
done

# The end-to-end test makes its own private test instance; it never reads env/<env>.json
# and never runs on prod.
if [ "$cmd" = e2e ]; then
  if [ -n "$env" ] && [ "$env" != test ]; then
    echo "atlas: e2e runs only on a private test instance, never on $env" >&2; exit 1
  fi
  cd "$root/e2e" && exec mix atlas.e2e ${args[@]+"${args[@]}"}
fi

settings="${ATLAS_ENV_FILE:-}"
if [ -z "$settings" ]; then
  env="${env:-prod}"
  settings="$root/env/$env.json"
fi
[ -f "$settings" ] || { echo "atlas: no environment '$env' (no $settings)" >&2; exit 1; }
# Absolute, so the core and the clients find it from their own folders.
settings="$(cd "$(dirname "$settings")" && pwd -P)/$(basename "$settings")"
[ -z "${ATLAS_ENV_FILE:-}" ] || export ATLAS_ENV_FILE="$settings"

# A value from the settings file: plutil on macOS, jq elsewhere (CI).
setting() {
  local v
  if command -v plutil >/dev/null; then v="$(plutil -extract "$1" raw -o - "$settings")"; else v="$(jq -er ".$1" "$settings")"; fi
  echo "${v/#\~/$HOME}"
}
# The file says which environment it is; a private file without --env is that one.
file_env="$(setting env)"
env="${env:-$file_env}"
case "$env" in test|prod) ;; *) echo "atlas: no environment '$env'; use --env test or --env prod" >&2; exit 1 ;; esac
if [ "$file_env" != "$env" ]; then
  echo "atlas: $settings is for $file_env, not $env" >&2; exit 1
fi
export ATLAS_ROOT="$root" ATLAS_ENV="$env"

has_setting() {
  if command -v plutil >/dev/null; then plutil -extract "$1" raw -o - "$settings" >/dev/null 2>&1
  else jq -e ".$1" "$settings" >/dev/null 2>&1; fi
}

port="$(setting control.port)"
fly_app=""
if has_setting fly.app; then
  # The core and rela run on Fly (IS-Atlas-26). control.port is this Mac's end of the
  # tunnel to Control; this Mac keeps only the tunnel's files and the TUI's agent log.
  fly_app="$(setting fly.app)"
  fly_rela_app="$(setting fly.rela_app)"
  fly_port="$(setting fly.control_port)"
  export ATLAS_TEST_ROOT="$(setting fly.local)"
else
  rela_url="$(setting rela.url)"
  # The rela scripts take their port, data and binaries from these.
  export ATLAS_RELA_PORT="$(setting rela.port)" ATLAS_RELA_DATA="$(setting rela.data)" ATLAS_RELA_BIN="$(setting rela.bin)"
  export ATLAS_TEST_ROOT="$(dirname "$ATLAS_RELA_DATA")"
fi

# The background core's files, beside rela's (the same files the stopgap used).
state="$ATLAS_TEST_ROOT"
pidfile="$state/core.pid"
headfile="$state/core.head"
log="$state/core.log"

head_now() { git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown; }
listening() { nc -z 127.0.0.1 "$port" 2>/dev/null; }

core_pid() {
  local pid; pid="$(cat "$pidfile" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

stop_core() {
  local pid; pid="$(core_pid || true)"
  if [ -n "$pid" ]; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  # A core started by hand (atlas up) on this environment's port is stopped too.
  local other; other="$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -n "$other" ]; then
    kill -TERM $other 2>/dev/null || true
    for _ in $(seq 1 20); do listening || break; sleep 0.5; done
  fi
  rm -f "$pidfile" "$headfile"
}

start_core() {
  echo "atlas: starting the core from $root at $(head_now) (a first start compiles, about half a minute)..."
  mkdir -p "$state"
  nohup "$root/bin/atlas" up --env "$env" >"$log" 2>&1 </dev/null &
  echo $! >"$pidfile"
  head_now >"$headfile"
  for _ in $(seq 1 240); do
    listening && { echo "atlas: core ready"; return 0; }
    kill -0 "$(cat "$pidfile")" 2>/dev/null || { echo "atlas: the core stopped; the last lines of $log:" >&2; tail -20 "$log" >&2; exit 1; }
    sleep 0.5
  done
  echo "atlas: the core did not start within 2 minutes; see $log" >&2
  exit 1
}

# A core from another build than this checkout is restarted, so nobody tries an old build.
ensure_core() {
  if listening && [ "$(cat "$headfile" 2>/dev/null)" != "$(head_now)" ]; then
    echo "atlas: the running core is not this build ($(head_now)); restarting it"
    stop_core
  fi
  listening || { [ -z "$(core_pid || true)" ] || stop_core; start_core; }
}

# The main clone follows develop: take the newest build before trying it.
update_build() {
  [ -z "${ATLAS_NO_UPDATE:-}" ] || return 0
  if [ "$(main_clone)" = "$root" ] && [ "$(git -C "$root" branch --show-current)" = develop ]; then
    git -C "$root" pull --ff-only -q || echo "atlas: could not update develop; trying the build as it is" >&2
    # What a rename or a move on develop left behind: folders with only build output.
    "$root/bin/clean-build" "$root" --moved >&2
  fi
}

# Build output of apps no mix.exs declares any more goes before anything compiles, so a
# renamed app never stops the core from starting (IS-Atlas-67).
clean_build() { "$root/bin/clean-build" "$root" >&2; }

# The repository's main clone (not a worktree of it). git answers an absolute path, so
# this works from any folder, also from / or from inside another repository.
main_clone() {
  local common
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  (cd "$common/.." && pwd -P)
}

# rela keeps the description it started with. When this build's differs (a merge changed
# rela/schema.yaml), rela is restarted on it first, its data kept (IS-Atlas-73). When the
# new description would leave data without a description (a removed kind or field that
# still has data), nothing is started: that needs a migration first.
ensure_rela() {
  local description="$root/rela/scripts/description.sh" orphans holder
  if ! curl -fsS -o /dev/null "$rela_url/_schema" 2>/dev/null; then
    "$root/rela/scripts/start-bg.sh"
    return
  fi
  "$description" same && return 0

  if ! orphans="$("$description" fits)"; then
    echo "atlas: rela $env runs an older description, and this build's no longer describes data it holds:" >&2
    echo "$orphans" | sed 's/^/  /' >&2
    echo "atlas: migrate that data first ($(migrations)), then: atlas restart --env $env" >&2
    exit 1
  fi

  if ! "$root/rela/scripts/stop.sh" >/dev/null 2>&1; then
    holder="$(lsof -nP -t -iTCP:"$ATLAS_RELA_PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
    echo "atlas: rela $env runs an older description than this build, and atlas did not start it, so it cannot restart it." >&2
    echo "atlas: stop it (kill ${holder:-<pid>}), then: atlas restart --env $env" >&2
    exit 1
  fi
  "$root/rela/scripts/start-bg.sh" >/dev/null
  echo "atlas: rela $env ran an older description; restarted it on this build's (its data stays)"
}

# The tunnel to an environment on Fly: `fly proxy` from this Mac's control.port to Control
# on the environment's private network, over WireGuard. It runs in the background, like
# the core does when it runs on this Mac, and the commands open it when it is not.
tunnel_pidfile() { echo "$ATLAS_TEST_ROOT/tunnel.pid"; }
tunnel_log() { echo "$ATLAS_TEST_ROOT/tunnel.log"; }
fly_cli() {
  command -v fly || command -v flyctl || {
    echo "atlas: $env runs on Fly; install flyctl (brew install flyctl), then: fly auth login" >&2
    exit 1
  }
}
tunnel_pid() {
  local pid; pid="$(cat "$(tunnel_pidfile)" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}
stop_tunnel() {
  local pid; pid="$(tunnel_pid || true)"
  [ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null || true
  rm -f "$(tunnel_pidfile)"
}
ensure_tunnel() {
  local fly holder
  if tunnel_pid >/dev/null && listening; then return 0; fi
  stop_tunnel
  if listening; then
    holder="$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
    echo "atlas: port $port is taken by pid ${holder:-?}, not by atlas's tunnel to $fly_app; stop it first" >&2
    exit 1
  fi
  fly="$(fly_cli)"
  mkdir -p "$ATLAS_TEST_ROOT"
  echo "atlas: opening the tunnel to $env's Control on Fly ($fly_app, over WireGuard)" >&2
  nohup "$fly" proxy "$port:$fly_port" -a "$fly_app" -q >"$(tunnel_log)" 2>&1 </dev/null &
  echo $! >"$(tunnel_pidfile)"
  for _ in $(seq 1 120); do
    listening && return 0
    if ! kill -0 "$(cat "$(tunnel_pidfile)")" 2>/dev/null; then
      echo "atlas: the tunnel to $fly_app did not open; the last lines of $(tunnel_log):" >&2
      tail -5 "$(tunnel_log)" >&2
      echo "atlas: is flyctl logged in to the eyra organisation? fly auth whoami" >&2
      exit 1
    fi
    sleep 0.5
  done
  echo "atlas: the tunnel to $fly_app did not open within a minute; see $(tunnel_log)" >&2
  exit 1
}

# What only an environment on Fly does differently; the rest of the commands below serve both.
if [ -n "$fly_app" ]; then
  on_fly="$env runs on Fly ($fly_app and $fly_rela_app); a merge to develop deploys it"
  case "$cmd" in
    up) echo "atlas: $on_fly, so there is no core to run here" >&2; exit 1 ;;
    stop) stop_tunnel; echo "atlas: closed this Mac's tunnel to $fly_app; $on_fly"; exit 0 ;;
    restart)
      stop_tunnel; ensure_tunnel
      echo "atlas: reopened the tunnel; $on_fly, so its build is develop's (atlas status)"
      exit 0 ;;
    status)
      echo "env:    $env ($settings), on Fly"
      echo "build:  $root at $(head_now) (this Mac's clients; the core is what CI deployed, below)"
      if pid="$(tunnel_pid)" && listening; then
        echo "tunnel: open (pid $pid), 127.0.0.1:$port -> $fly_app:$fly_port, log $(tunnel_log)"
      else
        echo "tunnel: closed; any command opens it"
      fi
      fly="$(fly_cli)"
      for app in "$fly_app" "$fly_rela_app"; do
        "$fly" status -a "$app" 2>&1 | sed '/^$/d; s/^/  /' || true
      done
      exit 0 ;;
    logs) exec "$(fly_cli)" logs -a "$fly_app" ;;
    rela-status) exec "$(fly_cli)" status -a "$fly_rela_app" ;;
    rela-stop) echo "atlas: $on_fly; rela keeps running there" >&2; exit 1 ;;
    migrate-*) echo "atlas: the migrations read rela on this Mac; $on_fly" >&2; exit 1 ;;
    move-to-fly)
      export ATLAS_FLY_APP="$fly_app" ATLAS_FLY_RELA_APP="$fly_rela_app"
      export ATLAS_MOVE_FROM="$(setting fly.move_from)"
      exec "$root/fly/move-to-fly.sh" ${args[@]+"${args[@]}"} ;;
    put|set|get|list|delete|tools|plan|steer|help|load-plan) ensure_tunnel ;;
  esac
elif [ "$cmd" = move-to-fly ]; then
  echo "atlas: $env does not run on Fly ($settings has no \"fly\")" >&2
  exit 1
fi

# The migrations this script offers, from its own usage above.
migrations() {
  local found
  found="$(sed -n 's/^#   \(atlas migrate-[a-z-]*\).*/\1 --env '"$env"'/p' "$root/bin/atlas" | paste -sd ',' - | sed 's/,/, /g')"
  echo "${found:-see docs/guides/prod.md}"
}

case "$cmd" in
  tui)
    update_build
    if [ -n "$fly_app" ]; then ensure_tunnel; else ensure_rela; fi
    clean_build
    [ -n "$fly_app" ] || ensure_core
    # Ctrl-S saves a form; without this the terminal would take it as "pause output".
    saved="$(stty -g 2>/dev/null || true)"
    stty -ixon 2>/dev/null || true
    cd "$root/clients/tui"
    status=0
    mix atlas.tui --env "$env" || status=$?
    [ -n "$saved" ] && stty "$saved" 2>/dev/null || true
    exit $status
    ;;
  up)
    ensure_rela
    echo "rela $env: answering at $rela_url"
    clean_build
    cd "$root/beam"
    exec mix run --no-halt
    ;;
  stop) stop_core; echo "atlas: core stopped (rela keeps running)" ;;
  restart)
    stop_core
    ensure_rela
    start_core
    ;;
  status)
    echo "env:    $env ($settings)"
    echo "build:  $root at $(head_now)"
    if pid="$(core_pid)"; then
      echo "core:   running (pid $pid, build $(cat "$headfile" 2>/dev/null)), log $log"
    elif listening; then
      echo "core:   a core listens on $port, started by hand (atlas up)"
    else
      echo "core:   not running"
    fi
    "$root/rela/scripts/status.sh" 2>&1 | sed 's/^/rela:   /' || true
    if "$root/rela/scripts/description.sh" same; then
      echo "rela:   description: this build's"
    else
      echo "rela:   description: older than this build's; atlas restart --env $env restarts rela on it"
    fi
    ;;
  logs) exec tail -f "$log" ;;
  where) echo "$root" ;;
  main-clone) main_clone ;;
  env) echo "$env $settings" ;;
  install)
    # Only the main clone: a worktree goes away, and its build is not develop.
    if [ "$(main_clone)" != "$root" ]; then
      echo "atlas: install from the main clone ($(main_clone)), not from a worktree" >&2
      exit 1
    fi
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$root/bin/atlas" "$HOME/.local/bin/atlas"
    echo "atlas: ~/.local/bin/atlas -> $root/bin/atlas"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "atlas: add ~/.local/bin to your PATH" ;; esac
    ;;
  # The clients run in their own folders; a path the caller gives is read from where they called.
  put|set|get|list|delete|tools|plan|steer|help)
    # `atlas help` (not --json) starts with this script's own commands; `atlas help <kind>`
    # shows that kind only.
    kind_named=""
    for arg in ${args[@]+"${args[@]}"}; do case "$arg" in -*) ;; *) kind_named=1 ;; esac; done
    if [ "$cmd" = help ] && [ -z "$kind_named" ] && [[ " ${args[*]-} " != *" --json "* ]]; then
      header; echo
    fi
    clean_build
    cd "$root/clients/agent"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.agent "$cmd" --env "$env" ${args[@]+"${args[@]}"}
    ;;
  load-plan)
    clean_build
    cd "$root/tools/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.load_plan --env "$env" ${args[@]+"${args[@]}"}
    ;;
  migrate-owner)
    cd "$root/tools/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.migrate_owner --env "$env" ${args[@]+"${args[@]}"}
    ;;
  migrate-completion)
    (cd "$root/tools/plan" && mix compile >&2 &&
      ATLAS_CALLER_CWD="$caller" mix atlas.migrate_completion --env "$env" ${args[@]+"${args[@]}"})
    # rela keeps a removed field's values and refuses to change them over its API; its own
    # garbage collection removes them, with rela stopped (it holds the store's index).
    if [[ " ${args[*]-} " != *" --dry-run "* ]]; then
      echo "atlas: stopping rela $env to remove the old completed values"
      "$root/rela/scripts/stop.sh"
      # A first scan records the orphans; once they are older than the grace they go.
      "$ATLAS_RELA_BIN/rela" --project "$ATLAS_RELA_DATA" --quiet migrate gc --scan >/dev/null
      sleep 2
      "$ATLAS_RELA_BIN/rela" --project "$ATLAS_RELA_DATA" --quiet migrate gc --scan --grace=1s --apply
      "$root/rela/scripts/start-bg.sh"
    else
      echo "atlas: a real run then stops rela $env, removes the old completed values (rela migrate gc) and starts it again"
    fi
    ;;
  migrate-assignment)
    # Who set each old owner shows only on the old core, so it is read first and kept; then
    # rela and the core move to this build's description, which the data does not fit yet
    # (the old field), and the migration writes; rela's garbage collection ends it.
    origins="$ATLAS_TEST_ROOT/assignment-origins.json"
    migrate() {
      (cd "$root/tools/plan" && mix compile >&2 &&
        ATLAS_CALLER_CWD="$caller" mix atlas.migrate_assignment --env "$env" "$@")
    }
    if [[ " ${args[*]-} " == *" --dry-run "* ]]; then
      migrate --dry-run
      echo "atlas: a real run keeps who set each owner, restarts rela $env and the core on this build, writes, and removes the old values (rela migrate gc)"
      exit 0
    fi
    if ! "$root/rela/scripts/description.sh" same; then
      migrate --keep-origins "$origins"
      echo "atlas: restarting rela $env and the core on this build's description"
      stop_core
      "$root/rela/scripts/stop.sh"
      "$root/rela/scripts/start-bg.sh" >/dev/null
      start_core
    fi
    migrate --origins "$origins"
    echo "atlas: stopping rela $env to remove the old expected values"
    "$root/rela/scripts/stop.sh"
    "$ATLAS_RELA_BIN/rela" --project "$ATLAS_RELA_DATA" --quiet migrate gc --scan >/dev/null
    sleep 2
    "$ATLAS_RELA_BIN/rela" --project "$ATLAS_RELA_DATA" --quiet migrate gc --scan --grace=1s --apply
    "$root/rela/scripts/start-bg.sh"
    ;;
  rela-status) exec "$root/rela/scripts/status.sh" ;;
  rela-stop) exec "$root/rela/scripts/stop.sh" ;;
  *) usage ;;
esac
